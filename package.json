{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "app:dev": "pnpm --dir app dev",
    "app:test": "pnpm --dir app test",
    "app:type-check": "pnpm --dir app type-check",
    "cli:test": "node --test packages/cli/test/*.test.mjs",
    "cli:pack-check": "pnpm --dir packages/cli pack --out ../../tmp/product-grid-cli-pack-check",
    "changeset:add": "node scripts/add-changeset.ts",
    "changeset:status": "changeset status",
    "release:check": "pnpm cli:test && pnpm cli:pack-check",
    "release": "pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8"
  }
}
